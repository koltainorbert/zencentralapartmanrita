      "data": {
        "title": "Často kladené otázky",
        "groups": [
          {
            "title": "Rezervácia a kontakt",
            "items": [
              {
                "q": "Ako si môžem rezervovať apartmán?",
                "a": "<p>Rezervovať môžete na <a href=\"https://www.zencentralapartments.com/\">www.zencentralapartments.com</a> alebo telefonicky na čísle <b>+36 30 116 9431</b>.</p>"
              },
              {
                "q": "Musím zaplatiť zálohu?",
                "a": "<p>Áno, záloha predstavuje 50 % z celkovej sumy. Pri rezerváciách cez niektoré partnerské portály sa celá suma platí vopred.</p>"
              },
              {
                "q": "Ako môžem zrušiť rezerváciu?",
                "a": "<p>Pri priamych rezerváciách (webstránka, e-mail) je zrušenie bezplatné do <b>15 dní</b> pred príchodom a zaplatenú sumu vám vrátime.<br>Pri zrušení v lehote kratšej ako 15 dní účtujeme <b>50 %</b> ceny ubytovania, v prípade nedostavenia sa <b>100 %</b> ako storno poplatok. Zrušenie nám, prosím, pošlite e-mailom: <b>zencentralapartments@gmail.com</b></p>"
              }
            ]
          },
          {
            "title": "Príchod a odchod",
            "items": [
              {
                "q": "Kedy je check-in a check-out?",
                "a": "<p>Apartmán je pre vás pripravený od <b>14:00</b> a v deň odchodu vás prosíme o jeho uvoľnenie do <b>10:00</b>. Skorší príchod alebo neskorší odchod je možný po predchádzajúcej dohode, podľa obsadenosti a za príplatok.</p>"
              },
              {
                "q": "Prídeme veľmi neskoro – ako sa dostaneme dnu?",
                "a": "<p>Check-in je samoobslužný cez trezor na kľúče, takže neskorý príchod nie je žiadny problém.</p>"
              }
            ]
          },
          {
            "title": "Platba a fakturácia",
            "items": [
              {
                "q": "Kedy mám zaplatiť?",
                "a": "<p>Zvyšnú sumu po odpočítaní zálohy uhradíte pri príchode.</p>"
              },
              {
                "q": "Aké spôsoby platby prijímate?",
                "a": "<ul><li>Hotovosť alebo bankový prevod (pri priamych rezerváciách)</li><li>Platobná karta (MasterCard, Maestro, VISA, VISA Electron) – iba online, pri rezervácii cez webstránku alebo partnerské portály</li><li>Kartu SZÉP momentálne neprijímame</li></ul>"
              },
              {
                "q": "Obsahujú ceny DPH a miestnu daň?",
                "a": "<p>Ceny obsahujú DPH, ale nie miestnu daň z ubytovania. Tá je 500 HUF / osoba / noc (nad 18 rokov).</p>"
              }
            ]
          },
          {
            "title": "Služby a vybavenie",
            "items": [
              {
                "q": "Čo je zahrnuté v cene?",
                "a": "<p>Cena zahŕňa ubytovanie bez stravy a navyše:</p><ul><li>bezplatné WiFi v celom apartmáne</li><li>bezplatné parkovanie na dvore alebo pred domom</li><li>DPH</li><li>základné potreby pre domácnosť a hygienu</li></ul>"
              },
              {
                "q": "Je v apartmáne internet?",
                "a": "<p>Áno, v celej budove je k dispozícii rýchle bezdrôtové pripojenie.</p>"
              },
              {
                "q": "Môžeme si v apartmáne variť?",
                "a": "<p>Áno, každý apartmán má dobre vybavenú kuchyňu – nájdete v nej príbor, riad, poháre, rýchlovarnú kanvicu, chladničku, kávovar, indukčnú varnú dosku aj mikrovlnnú rúru.</p>"
              },
              {
                "q": "Musíme si priniesť bežné veci?",
                "a": "<p>Nie. Uteráky, posteľnú bielizeň, príbor, poháre, fén, toaletný papier, dezinfekciu na ruky aj vešiaky pre vás máme pripravené.</p>"
              },
              {
                "q": "Kúri sa v zime?",
                "a": "<p>Áno, naše apartmány si môžete rezervovať po celý rok a majú moderné vykurovanie.</p>"
              }
            ]
          },
          {
            "title": "Ďalšie informácie",
            "items": [
              {
                "q": "Môžeme prísť s domácim zvieratkom?",
                "a": "<p>Hoci zvieratá milujeme, domácich miláčikov v našich apartmánoch ubytovať nemôžeme.</p>"
              },
              {
                "q": "Kde môžem fajčiť?",
                "a": "<p>Apartmány sú nefajčiarske. Fajčiť je možné iba na vyhradenom mieste na dvore alebo na spoločnej terase.</p>"
              },
              {
                "q": "Kde môžem parkovať?",
                "a": "<p>Ku každému apartmánu patrí 1 vlastné parkovacie miesto. Ak prídete s viacerými autami, kontaktujte nás, prosím, vopred; k dispozícii je aj bezplatné parkovanie na ulici.</p>"
              }
            ]
          },
          {
            "title": "Poloha",
            "items": [
              {
                "q": "Kde presne sa nachádzajú ZEN Central Apartments?",
                "a": "<p>Adresa: 8200 Veszprém, Festő utca 6. Centrum mesta je len pár minút chôdze; okolie je pokojné a bezpečné – ideálne na oddych aj spoznávanie mesta.</p>"
              }
            ]
          }
        ]
      }
